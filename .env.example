# Copy to .env (docker compose reads it automatically) and adjust.

# Host port the dashboard is published on (mapped to 8080 inside the container).
HOST_PORT=8080

# Admin username (written into the config on FIRST boot only).
ADMIN_USER=admin

# Admin password:
#   • Leave BLANK for a strong RANDOM password generated on first boot and
#     printed once in `docker compose logs`.
#   • Or set a value here to pin a known password.
ADMIN_PASSWORD=

# Whole-container safety limits. These include Chromium and external tools,
# unlike a Go heap limit. See README.Docker.md for sizing recommendations.
RECON_MEMORY_LIMIT=3g
RECON_PIDS_LIMIT=512
